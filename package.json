{
  "name": "design-system-react",
  "version": "0.10.64",
  "description": "Salesforce Lightning Design System for React",
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "start": "npm run dev",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/salesforce/design-system-react.git"
  },
  "keywords": [
    "react",
    "slds",
    "salesforce",
    "salesforce-ux",
    "lightning",
    "design system",
    "lightning design system",
    "salesforce-lightning",
    "salesforce lightning design system",
    "interactive components",
    "interactive",
    "components"
  ],
  "bugs": {
    "url": "https://github.com/salesforce/design-system-react/issues"
  },
  "main": "dist/design-system-react.umd.js",
  "module": "dist/design-system-react.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/design-system-react.es.js",
      "require": "./dist/design-system-react.umd.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "homepage": "https://react.lightningdesignsystem.com",
  "dependencies": {
    "classnames": "^2.5.1",
    "column-resizer": "^1.3.6",
    "create-react-class": "^15.7.0",
    "lodash.assign": "^4.2.0",
    "lodash.escaperegexp": "^4.1.2",
    "lodash.find": "^4.6.0",
    "lodash.findindex": "^4.6.0",
    "lodash.isdate": "^4.0.1",
    "lodash.isequal": "^4.5.0",
    "lodash.isfunction": "^3.0.9",
    "lodash.reject": "^4.6.0",
    "memoize-one": "^6.0.0",
    "nanoid": "^5.0.9",
    "popper.js": "^1.16.1",
    "react-contenteditable": "^3.3.7",
    "react-highlighter-ts": "^2.2.0",
    "react-modal": "^3.16.1",
    "react-onclickoutside": "^6.13.1",
    "react-required-if": "^1.0.3",
    "react-text-truncate": "^0.19.0",
    "warning": "^4.0.3"
  },
  "peerDependencies": {
    "@salesforce-ux/design-system": "2.25.0-alpha.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@salesforce-ux/design-system": "2.25.0-alpha.2",
    "@salesforce-ux/icons": "10.x",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-links": "^10.1.4",
    "@storybook/react": "^10.1.4",
    "@storybook/react-vite": "^10.1.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/lodash.assign": "^4.2.9",
    "@types/lodash.escaperegexp": "^4.1.9",
    "@types/lodash.find": "^4.6.9",
    "@types/lodash.findindex": "^4.6.9",
    "@types/lodash.isdate": "^4.0.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.isfunction": "^3.0.9",
    "@types/lodash.reject": "^4.6.9",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-modal": "^3.16.3",
    "@types/warning": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vueless/storybook-dark-mode": "^10.0.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^10.1.4",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.1.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0",
    "vitest": "^1.4.0"
  }
}
